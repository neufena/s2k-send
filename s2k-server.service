# Install (from the project folder, on the Pi):
#           sudo make install                                     (builds s2kexec into /usr/local/bin)
#           sudo python3 -m venv /opt/s2k-send && sudo /opt/s2k-send/bin/pip install .
#           sudo mkdir -p /var/lib/s2k-send
#           sudo cp s2k-server.service /etc/systemd/system/ && sudo systemctl daemon-reload
#           sudo systemctl enable --now s2k-server
# The server must run as root (it drives the GPIO bus and stops/starts the piscsi service).
# Home network only: there is no authentication.
[Unit]
Description=Akai S2000 sample transfer server (PiSCSI initiator)
After=network-online.target

[Service]
Type=simple
ExecStart=/opt/s2k-send/bin/s2kserver --data-dir /var/lib/s2k-send --target 6 --initiator 0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
